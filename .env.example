# 데이터 파이프라인·서버용 키 — 서버/로컬 전용, 클라이언트 번들 포함 금지 (SPEC §9.4)
# 사용: cp .env.example .env 후 값 입력 → set -a; source .env; set +a
#
# KTO 키는 data.go.kr "페어 키"로 단일화 (구 hex 키는 웰니스 API 403 — SPEC §7.2)
KTO_SERVICE_KEY=        # 디코딩 키 — HTTP 라이브러리가 URL 인코딩해 줄 때 (예: requests params=)
KTO_SERVICE_KEY_ENC=    # 인코딩 키 — URL 문자열에 직접 이어붙일 때
KAKAO_REST_KEY=         # 카카오 REST 키 — 지오코딩·로컬 검색·모빌리티 (서버 전용)
KAKAO_JS_KEY=           # 카카오 JavaScript 키 — 지도 SDK (design/.env의 VITE_KAKAO_MAP_KEY와 동일 값)
