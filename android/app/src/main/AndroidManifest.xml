<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 대회·관광 API 호출용 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      S8 "내 위치" 출발지. (SPEC §4.11-1 ①)
      둘 다 선언하되 **거부해도 화면은 동작한다** — 검색·프리셋으로 출발지를 정할 수 있다(NFR-15).
      배경 위치는 요청하지 않는다. 앱이 보이는 동안 한 번 조회할 뿐이다.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".RunningGuApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RunningGu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RunningGu"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          카카오 로그인이 끝나고 앱으로 돌아오는 자리. (AP-08 · §4.1 · §1-7)

          카카오톡이 깔려 있으면 톡으로, 없으면 카카오 계정 웹으로 로그인하고
          `kakao{네이티브키}://oauth` 로 되돌아온다. 스킴에 키가 들어가므로
          `manifestPlaceholders` 로 주입한다 — 저장소에 키를 두지 않는다(AGENTS 8장).

          `exported="true"` 여야 카카오톡·브라우저가 이 액티비티를 열 수 있다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>
    </application>

</manifest>