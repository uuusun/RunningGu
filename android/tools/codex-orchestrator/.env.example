# Optional executable override. Must still be the Codex CLI; API clients are unsupported.
CODEX_EXECUTABLE=codex

# Real account integration test is opt-in. Default tests use only Mock App Server.
CODEX_INTEGRATION_TEST=false

# Use a local JDK 17 or newer. Never put API keys in this file.
JAVA_HOME=C:\path\to\jdk-17-or-newer
