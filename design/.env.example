# 복사: cp .env.example .env 후 값 입력. 셋 다 선택 — 없으면 폴백으로 동작 (SPEC NFR-1)

# ── 지도 (클라이언트 노출 키) ──
# 카카오맵 JavaScript 키. 없으면 SVG 폴백 지도 + 사전수집/합성 샘플 POI로 동작.
# 카카오 콘솔 Web 플랫폼에 http://localhost:5173 도메인 등록 필수 (SPEC §7.3)
VITE_KAKAO_MAP_KEY=

# ── dev 프록시 주입 키 (vite.config.js가 서버측에서 주입 — 브라우저 무노출) ──
# TourAPI(인근 축제 등) — data.go.kr "디코딩" 키. 루트 .env의 KTO_SERVICE_KEY와 동일 값.
TOUR_API_KEY=
# 카카오 REST 키 — 러닝코스 출발지 검색·걷기 스팟. 루트 .env의 KAKAO_REST_KEY와 동일 값.
KAKAO_REST_KEY=
