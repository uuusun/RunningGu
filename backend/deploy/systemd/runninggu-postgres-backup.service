[Unit]
Description=런닝구 PostgreSQL pgBackRest 일일 전체 백업
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=runninggu-backup-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/runninggu/repository/backend
ExecStartPre=/usr/bin/docker compose --env-file /etc/runninggu/compose.env -f compose.yaml -f compose.ec2.yaml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/runninggu/compose.env -f compose.yaml -f compose.ec2.yaml exec -T --user postgres postgres pgbackrest --stanza=runninggu --type=full backup
ExecStart=/usr/bin/docker compose --env-file /etc/runninggu/compose.env -f compose.yaml -f compose.ec2.yaml exec -T --user postgres postgres pgbackrest --stanza=runninggu expire
ExecStart=/usr/bin/docker compose --env-file /etc/runninggu/compose.env -f compose.yaml -f compose.ec2.yaml exec -T --user postgres postgres pgbackrest --stanza=runninggu check

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=runninggu-postgres-backup
