[Unit]
Description=런닝구 Spring Boot 백엔드
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=runninggu-backend-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=runninggu
Group=runninggu
WorkingDirectory=/opt/runninggu/current
EnvironmentFile=/etc/runninggu/application.env
# Docker socket을 쓰는 readiness gate만 root로 실행하고 JVM은 runninggu 사용자로 유지한다.
ExecStartPre=+/bin/sh /opt/runninggu/repository/backend/deploy/backend/wait-for-postgres.sh
ExecStart=/bin/sh /opt/runninggu/repository/backend/deploy/backend/start-backend.sh

Restart=on-failure
RestartSec=5
TimeoutStartSec=125s
TimeoutStopSec=30
# 승인된 EC2 4GiB 운영값. heap 256m~512m와 함께 적용한다(계약 §8.1).
# 기존 memory.conf 등 drop-in이 있으면 배포 후 실효 값도 확인한다.
MemoryHigh=640M
MemoryMax=768M

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=runninggu-backend

[Install]
WantedBy=multi-user.target
