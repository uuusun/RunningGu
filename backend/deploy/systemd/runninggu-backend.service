[Unit]
Description=런닝구 Spring Boot 백엔드
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=runninggu-backend-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=runninggu
Group=runninggu
WorkingDirectory=/opt/runninggu/current
EnvironmentFile=/etc/runninggu/application.env
# Docker socket을 쓰는 readiness gate만 root로 실행하고 JVM은 runninggu 사용자로 유지한다.
ExecStartPre=+/bin/sh /opt/runninggu/repository/backend/deploy/backend/wait-for-postgres.sh
ExecStart=/bin/sh /opt/runninggu/repository/backend/deploy/backend/start-backend.sh

Restart=on-failure
RestartSec=5
TimeoutStartSec=125s
TimeoutStopSec=30
# 첫 8GiB baseline은 무제한으로 측정한다. §9.3 합격 뒤 둘을 관측값으로 함께 교체한다.
MemoryHigh=infinity
MemoryMax=infinity

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=runninggu-backend

[Install]
WantedBy=multi-user.target
