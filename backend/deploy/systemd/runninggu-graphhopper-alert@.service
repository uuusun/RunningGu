[Unit]
Description=런닝구 GraphHopper 실패 SNS 알림 (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/runninggu/graphhopper-alert.env
ExecStart=/bin/sh /opt/runninggu/repository/backend/deploy/graphhopper/notify-graphhopper-failure.sh %i

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=runninggu-graphhopper-alert
