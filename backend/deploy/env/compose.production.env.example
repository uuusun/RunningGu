# Docker Compose 운영 전용 예시다. 실제 파일은 /etc/runninggu/compose.env에 둔다.
# DB_PASSWORD는 application.env와 같은 운영 전용 값을 사용한다.
DB_NAME=runninggu
DB_PORT=5432
DB_USERNAME=runninggu
DB_PASSWORD=

GRAPHHOPPER_PORT=8989
GRAPHHOPPER_SERVER_IMAGE=runninggu-graphhopper:11.0
GRAPHHOPPER_XMS=512m
GRAPHHOPPER_XMX=2g
GRAPHHOPPER_MEMORY_RESERVATION=2g
GRAPHHOPPER_MEMORY_LIMIT=2560m

# graph 원본 bucket은 공유하되 production prefix와 descriptor로 배포 승인을 분리한다.
GRAPHHOPPER_AWS_REGION=ap-northeast-2
GRAPHHOPPER_ENVIRONMENT=production
GRAPHHOPPER_S3_BUCKET=runninggu-staging-artifacts-987622176638
GRAPHHOPPER_S3_PREFIX=graphhopper

# 운영 백업은 스테이징과 bucket·prefix·IAM 권한을 분리한다.
PGBACKREST_REPO1_PATH=/runninggu/production
PGBACKREST_S3_BUCKET=runninggu-production-backup-987622176638-ap-northeast-2-an
PGBACKREST_S3_KMS_KEY_ID=arn:aws:kms:ap-northeast-2:987622176638:key/b18b8374-922a-46bb-bda9-78c98a22d679
PGBACKREST_S3_ROLE=runninggu-production-ec2
