# Spring Boot 운영 systemd 서비스 전용 예시다. 실제 파일은 /etc/runninggu/application.env에 둔다.
# 비밀값은 저장소에 넣지 않고 운영 환경에서 별도로 생성·주입한다.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=framework
RUNNINGGU_DEPLOYMENT_ENVIRONMENT=production

# 앱 API 부하 시험 가드는 production에서 항상 비활성이다.
UPSTREAM_LOAD_GUARD_ENABLED=false
UPSTREAM_LOAD_GUARD_RUN_ID=
UPSTREAM_LOAD_GUARD_KTO_ENDPOINT_LIMIT=0
UPSTREAM_LOAD_GUARD_KAKAO_TOTAL_LIMIT=0
UPSTREAM_LOAD_GUARD_KAKAO_ENDPOINT_LIMIT=0

# EC2 4GiB 확정값(graphhopper-artifact-contract.md §8.1).
BACKEND_XMS=256m
BACKEND_XMX=512m

DB_URL=jdbc:postgresql://127.0.0.1:5432/runninggu
DB_USERNAME=runninggu
DB_PASSWORD=

# Base64 디코딩 결과가 32바이트 이상인 HS256 키. 실제 값은 커밋 금지
JWT_SECRET=

# Kakao 자격 증명은 운영 전용이다.
# KTO service key는 2026-09-10 운영 결정에 따라 staging과 공유하며 호출 쿼터도 합산 관리한다.
KTO_SERVICE_KEY=
KAKAO_REST_KEY=
KAKAO_APP_ID=

COURSE_SYNC_ENABLED=true
GRAPHHOPPER_ENABLED=true
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@runninggu.store
SMTP_FROM_NAME=런닝구
MAIL_ENABLED=true
PASSWORD_RESET_URL=https://api.runninggu.store/reset-password

SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
