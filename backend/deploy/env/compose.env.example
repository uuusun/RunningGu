# Docker Compose 전용 예시다. 실제 파일은 /etc/runninggu/compose.env에 둔다.
# 값은 KEY=unquoted-value 형식으로 쓰며 작은따옴표·큰따옴표로 감싸지 않는다.
# DB 비밀번호는 두 환경 파일에 같은 값을 넣고 URL-safe 문자로 생성한다.
DB_NAME=runninggu
DB_PORT=5432
DB_USERNAME=runninggu
DB_PASSWORD=

GRAPHHOPPER_PORT=8989
GRAPHHOPPER_SERVER_IMAGE=runninggu-graphhopper:11.0
# 승인된 EC2 4GiB 운영값(2026-09-07, graphhopper-artifact-contract.md §8.1).
# 로컬 graph import용 heap과 구분한다. 누락·빈 값으로 배포하면 Compose가 거부한다.
GRAPHHOPPER_XMS=512m
GRAPHHOPPER_XMX=2g
GRAPHHOPPER_MEMORY_RESERVATION=2g
# mem_limit와 memswap_limit에 같은 값을 적용해 GraphHopper swap만 금지한다.
# 호스트 swap 4GiB·swappiness 10과 PostgreSQL 정책은 유지한다.
GRAPHHOPPER_MEMORY_LIMIT=2560m

# graph artifact 전용 비공개 S3. pgBackRest bucket/prefix와 분리한다.
GRAPHHOPPER_AWS_REGION=ap-northeast-2
GRAPHHOPPER_ENVIRONMENT=staging
GRAPHHOPPER_S3_BUCKET=
GRAPHHOPPER_S3_PREFIX=graphhopper

# S3 bucket 이름, 고객 관리형 KMS key ARN, EC2 instance profile role 이름
PGBACKREST_S3_BUCKET=
PGBACKREST_S3_KMS_KEY_ID=
PGBACKREST_S3_ROLE=
