# Spring Boot systemd 서비스 전용 예시다. 실제 파일은 /etc/runninggu/application.env에 둔다.
# backend/.env.example은 로컬 개발용이고 이 파일은 EC2 배포용이다.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=framework

# 첫 8GiB 시험 전에 후보값을 정하고 운영 기록에 남긴다. 빈 값이면 JVM 기동을 거부한다.
BACKEND_XMS=
BACKEND_XMX=

DB_URL=jdbc:postgresql://127.0.0.1:5432/runninggu
DB_USERNAME=runninggu
DB_PASSWORD=

# Base64 디코딩 결과가 32바이트 이상인 HS256 키. 실제 값은 커밋 금지
JWT_SECRET=

KTO_SERVICE_KEY=
KAKAO_REST_KEY=
# 카카오 Developers 내 앱의 숫자형 앱 ID. 실제 값은 커밋 금지
KAKAO_APP_ID=

COURSE_SYNC_ENABLED=true
GRAPHHOPPER_ENABLED=true
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=런닝구
MAIL_ENABLED=false
PASSWORD_RESET_URL=https://staging-api.runninggu.store/reset-password

# 스테이징 기본값은 비활성이다. 필요할 때만 접근 통제 뒤 별도로 활성화한다.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
