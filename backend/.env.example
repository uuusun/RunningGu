SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/runninggu
DB_NAME=runninggu
DB_PORT=5432
DB_USERNAME=runninggu
DB_PASSWORD=

JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=런닝구
MAIL_ENABLED=false

# 로컬·직접 연결은 none. 신뢰 가능한 프록시 뒤 운영에서는 framework 필수.
# 프록시는 전달 헤더를 덮어쓰고 원본 서버 직접 접근을 차단해야 한다.
# 프록시 배포에서 none이면 모든 사용자가 프록시 IP의 요청 제한을 공유한다.
FORWARD_HEADERS_STRATEGY=none

KTO_SERVICE_KEY=
KTO_SERVICE_KEY_ENC=
