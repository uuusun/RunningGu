SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/runninggu
DB_NAME=runninggu
DB_PORT=5432
DB_USERNAME=runninggu
DB_PASSWORD=

# Base64로 인코딩한 32바이트 이상 HS256 키. 실제 값은 커밋 금지
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=런닝구
MAIL_ENABLED=false
# 사용자가 메일 링크로 여는 백엔드 웹 재설정 페이지의 공개 URL
PASSWORD_RESET_URL=http://localhost:8080/reset-password

# 로컬·직접 연결은 none. 신뢰 가능한 프록시 뒤 운영에서는 framework 필수.
# 프록시는 전달 헤더를 덮어쓰고 원본 서버 직접 접근을 차단해야 한다.
# 프록시 배포에서 none이면 모든 사용자가 프록시 IP의 요청 제한을 공유한다.
FORWARD_HEADERS_STRATEGY=none

KTO_SERVICE_KEY=
KTO_SERVICE_KEY_ENC=
KAKAO_REST_KEY=
# 카카오 Developers 내 앱의 숫자형 앱 ID. 실제 값은 커밋 금지
KAKAO_APP_ID=

# 서버 내부 GraphHopper 11 run 프로파일. 그래프와 SRTM 캐시는 영속 디렉터리에 둔다.
GRAPHHOPPER_ENABLED=false
GRAPHHOPPER_BASE_URL=http://localhost:8989
GRAPHHOPPER_PORT=8989
# backend/compose.yaml 기준 경로. 약 300MB의 한국 OSM PBF는 저장소에 커밋하지 않는다.
GRAPHHOPPER_PBF_PATH=../.cache/osm/korea.osm.pbf
