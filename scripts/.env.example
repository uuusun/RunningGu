# scripts/ 전용 키 — 데이터 생성 스크립트용. (앱 키는 루트 local.properties에 — README 참고)
# 사용: cp .env.example .env 후 값 입력 → set -a; source .env; set +a
#
# KTO 키는 data.go.kr "페어 키" 사용 (구 hex 키는 웰니스 API 403 — SPEC §7.2)
KTO_SERVICE_KEY=        # 디코딩 키 — HTTP 라이브러리가 URL 인코딩해 줄 때 (예: requests params=)
KTO_SERVICE_KEY_ENC=    # 인코딩 키 — URL 문자열에 직접 이어붙일 때
KAKAO_REST_KEY=         # 카카오 REST 키 — geocode.py 지오코딩

# 심사 계정 표본 채우기 — scripts/judge/seed_judge_account.py (이슈 #293)
# 계정은 사람이 만들고 여기에는 로그인 정보만 둔다. .env 는 커밋하지 않는다.
RUNNINGGU_API_BASE_URL= # 운영/스테이징 API 주소 (예: https://staging-api.runninggu.store)
RUNNINGGU_JUDGE_EMAIL=  # 심사 계정 이메일 — 로그·요약에는 가려서 찍는다
RUNNINGGU_JUDGE_PASSWORD=
